# June AI 开发环境配置
# 复制此文件为 .env 后启动：cp .env.development .env

# 运行模式
JUNE_ENV=development
JUNE_DEBUG=true

# LLM API（留空则使用模拟回复，支持任何 OpenAI 兼容格式服务商）
# DeepSeek: LLM_BASE_URL=https://api.deepseek.com/v1  LLM_DEFAULT_MODEL=deepseek-chat
# OpenAI:   LLM_BASE_URL=https://api.openai.com/v1     LLM_DEFAULT_MODEL=gpt-4o
# Kimi:     LLM_BASE_URL=https://api.moonshot.cn/v1    LLM_DEFAULT_MODEL=moonshot-v1-128k
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_DEFAULT_MODEL=deepseek-chat

# CORS
JUNE_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# API 鉴权 Token（留空则首次启动自动生成，控制台会打印）
JUNE_API_TOKEN=

# 数据库路径（留空使用默认 backend/june.db）
JUNE_DB_PATH=

# 服务端口
SERVER_PORT=8000