# ============================================================
# June AI 生产环境配置
# ============================================================
# 复制此文件为 .env 后启动：cp .env.example .env
# 生产模式会强制校验必填项，缺少则启动失败。
# ============================================================

# ---- 运行模式 ----
JUNE_ENV=production
JUNE_DEBUG=false

# ---- LLM API 配置（必填，支持任何 OpenAI 兼容格式的服务商）----
# 方式一：使用通用配置（推荐）
# DeepSeek:      https://api.deepseek.com/v1        deepseek-chat
# OpenAI:        https://api.openai.com/v1           gpt-4o
# Moonshot Kimi: https://api.moonshot.cn/v1          moonshot-v1-128k
# Zhipu GLM:     https://open.bigmodel.cn/api/paas/v4  glm-4-flash
# Qwen 通义千问:  https://dashscope.aliyuncs.com/compatible-mode/v1  qwen-plus
# 本地 Ollama:    http://localhost:11434/v1           qwen2.5:7b
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_DEFAULT_MODEL=deepseek-chat

# 方式二：仅使用 DeepSeek（向后兼容，与上方二选一）
# DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# ---- CORS 跨域配置 ----
# 逗号分隔的允许来源列表
JUNE_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- 安全配置（必填） ----
# API Token: 至少 16 字符，用于保护所有 /api/ 接口
JUNE_API_TOKEN=change-me-to-a-random-string-at-least-32-chars
# 用户登录态与 BYOK Key 加密密钥：生产必须至少 32 字符
JUNE_AUTH_SECRET=change-me-to-a-random-32-byte-secret

# 初始管理员账号：密码只配置在本地 .env 或部署环境变量，不写入源码/示例文件
JUNE_ADMIN_IDENTITY=tony
JUNE_ADMIN_EMAIL=tony@june.local
JUNE_ADMIN_DISPLAY_NAME=Tony
JUNE_ADMIN_PASSWORD=

# ---- 支付配置 ----
# sandbox 仅限本地联调；生产必须替换为微信支付/支付宝正式通道
JUNE_PAYMENT_PROVIDER=sandbox
JUNE_PAYMENT_CALLBACK_SECRET=change-me-to-a-payment-callback-secret

# ---- 数据库 ----
# SQLite 数据库文件路径，留空使用默认 backend/june.db
# JUNE_DB_PATH=/data/june.db

# ---- 服务端口 ----
# SERVER_PORT=8000
